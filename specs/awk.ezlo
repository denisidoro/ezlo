# awk: POSIX awk (BSD one-true-awk on macOS, gawk/mawk on Linux). "(gawk)" = GNU awk only.

type awk_program
  values "{ print $1 }" "{ print $NF }" "{ print $1, $3 }" "NR > 1" "NR == 1" "!seen[$0]++" "{ s += $1 } END { print s }" "length > 80" "{ print NF }" "NF" "END { print NR }" "/pattern/ { print $0 }" "BEGIN { OFS = \"\\t\" } { $1 = $1; print }" "{ print length, $0 }"

type awk_field_separator
  values "," ":" ";" "\\t" "|" "=" "[ \\t]+" "[,;]"

type awk_lint
  values fatal invalid no-ext

cmd awk "Pattern scanning and processing language"
  opt -F --field-separator <fs> awk_field_separator "Input field separator (regex; -F, -F: -F'\\t')"
  opt -v --assign <assignment...> = "OFS=," | "OFS=\\t" | "n=10" "Assign a variable before running (var=value)"
  opt -f --file <file...> file "Read the program from a file (repeatable)"
  opt -e --source <program> awk_program "Program text, combinable with -f (gawk)" hidden
  opt -i --include <file> file "Include an awk source library (gawk)" hidden
  opt -l --load <library> "Load a dynamic extension (gawk)" hidden
  opt -b --characters-as-bytes "Treat all input as single-byte characters (gawk)" hidden
  opt -c --traditional "Compatibility mode, no GNU extensions (gawk)" hidden
  opt -P --posix "Strict POSIX mode (gawk)" hidden
  opt -k --csv "Parse input as CSV, with quoted fields (gawk 5.3+)"
  opt -M --bignum "Arbitrary-precision arithmetic (gawk)" hidden
  opt -n --non-decimal-data "Allow octal and hex values in input data (gawk)" hidden
  opt -S --sandbox "Disable system(), redirections and extensions (gawk)" hidden
  opt -L --lint [level] awk_lint "Warn about questionable constructs (gawk)" hidden
  opt -o --pretty-print [file] file "Pretty-print the program to awkprof.out or a file (gawk)" hidden
  opt -p --profile [file] file "Profile the run to awkprof.out or a file (gawk)" hidden
  opt -d --dump-variables [file] file "Dump global variables to awkvars.out or a file (gawk)" hidden
  opt -D --debug [file] file "Run the interactive debugger (gawk)" hidden
  opt -V --version "Print the version"
  arg [program] awk_program
  arg [file...] file

  recipe "Sum a numeric column"
    $ awk '{ s += $<column> } END { print s }' <file>
    arg <column> = 1 | 2 | 3
    arg <file> file

  recipe "Average of a numeric column"
    $ awk '{ s += $<column> } END { if (NR) print s / NR }' <file>
    arg <column> = 1 | 2 | 3
    arg <file> file

  recipe "Remove duplicate lines, keeping the first occurrence and order"
    $ awk '!seen[$0]++' <file>
    arg <file> file

  recipe "Print one column of a CSV"
    $ awk -F, '{ print $<column> }' <file>
    arg <column> = 1 | 2 | 3
    arg <file> file

  recipe "Print lines longer than N characters, with their line number"
    $ awk 'length > <n> { print FILENAME ":" FNR ": " $0 }' <file>
    arg <n> = 80 | 100 | 120
    arg <file> file

  recipe "Print a line range (like sed -n 'a,bp')"
    $ awk 'NR >= <start> && NR <= <end>' <file>
    arg <start> = 1 | 10 | 100
    arg <end> = 20 | 50 | 200
    arg <file> file

  recipe "Count occurrences of each value in a column"
    $ awk '{ c[$<column>]++ } END { for (k in c) print c[k], k }' <file> | sort -rn
    arg <column> = 1 | 2 | 3
    arg <file> file

  recipe "Convert a whitespace-separated table to TSV"
    $ awk 'BEGIN { OFS = "\t" } { $1 = $1; print }' <file>
    arg <file> file

alias gawk = awk
