# fzf: command-line fuzzy finder (0.50+; --tmux needs 0.53+, --style/--popup 0.58+).

type fzf_layout
  values default reverse reverse-list

type fzf_border
  values rounded sharp bold double block thinblock horizontal vertical top bottom left right line none

type fzf_preview_window
  values "right:50%" "right:60%:wrap" "up:40%" "down:50%" "down:3:wrap" "hidden" "right:hidden" "border-left" "+{2}-/2" "~3"

type fzf_bind
  values "ctrl-/:toggle-preview" "ctrl-a:select-all" "ctrl-d:deselect-all" "ctrl-y:execute-silent(echo -n {} | xclip -sel clip)" "ctrl-o:execute(nvim {})" "enter:become(nvim {})" "ctrl-r:reload(<command>)" "change:reload(<command> {q})" "start:reload(<command>)" "alt-up:preview-up" "alt-down:preview-down" "ctrl-u:preview-half-page-up" "ctrl-f:preview-half-page-down" "load:pos(1)" "focus:transform-header(echo {})" "tab:toggle+down"

type fzf_info
  values default right hidden inline inline-right

type fzf_tiebreak
  values length chunk pathname begin end index "length,begin" "pathname,length"

type fzf_preview
  values "bat --color=always --style=numbers --line-range=:500 {}" "cat {}" "head -n 100 {}" "ls -la {}" "tree -C {} | head -n 100" "git show --color=always {1}" "git log --oneline --color=always {}" "echo {}"

cmd fzf "Command-line fuzzy finder"
  opt -e --exact "Exact match (no fuzzy)"
  opt -i --ignore-case "Case-insensitive match" excludes --smart-case
  opt --smart-case "Smart-case match (default)" excludes -i --ignore-case hidden
  opt --scheme <scheme> = default | path | history "Scoring scheme"
  opt -n --nth <fields> = 1 | 2 | "2.." | "-1" | "1,3" "Fields to search (with -d)"
  opt --with-nth <fields> = 1 | 2 | "2.." | "-1" | "1,3" "Fields to display (with -d)"
  opt --accept-nth <fields> = 1 | 2 | "2.." | "-1" "Fields to print on accept (0.60+)"
  opt -d --delimiter <regex> = ":" | "\\t" | "," | " " | "/" "Field delimiter regex (default: AWK-style)"
  opt --literal "Don't normalize latin letters (accents)" hidden
  opt --tail <num> = 1000 | 10000 "Keep only the last N items in memory" hidden
  opt --disabled "No filtering: use as a selector (e.g. with reload binds)"
  opt --tiebreak <criteria> fzf_tiebreak "Sort criteria for equal scores"
  opt --no-sort "Don't sort the results"
  opt --tac "Reverse the input order"
  opt --read0 "Read NUL-delimited input"
  opt --print0 "Print NUL-delimited output"
  opt --ansi "Interpret ANSI color codes in the input"
  opt --sync "Wait for all input before starting" hidden
  opt -m --multi [max] = 2 | 10 "Multi-select with Tab/Shift-Tab (optional max)"
  opt --no-multi "Disable multi-select" hidden
  opt --cycle "Cyclic scroll"
  opt --track "Keep the current selection when the list updates"
  opt --highlight-line "Highlight the whole current line"
  opt --wrap [mode] = char | word "Wrap long lines"
  opt --keep-right "Keep the right end of long lines visible"
  opt --no-hscroll "Disable horizontal scroll" hidden
  opt --height <height> = "40%" | "50%" | "~40%" | "-3" | "20" "Show below the cursor with this height (~ adapts to content)"
  opt --min-height <height> = 10 | 20 "Minimum height with --height N%" hidden
  opt --tmux [opts] = center | "center,80%" | "80%,60%" | "right,40%" | "bottom,40%" "Open in a tmux popup (tmux 3.3+)" excludes --height
  opt --popup [opts] = center | "center,80%" | "right,40%" "Open in a tmux/Zellij popup (alias of --tmux)" excludes --height hidden
  opt --layout <layout> fzf_layout "Layout: reverse puts the prompt on top"
  opt --reverse "Alias of --layout=reverse"
  opt --style <preset> = default | minimal | full | "full:rounded" "Style preset (0.58+)"
  opt --border [style] fzf_border "Draw a border"
  opt --border-label <label> "Label on the border"
  opt --margin <margin> = 1 | "1,2" | "5%" "Screen margin (TRBL | TB,RL | T,RL,B | T,R,B,L)" hidden
  opt --padding <padding> = 1 | "1,2" "Padding inside the border" hidden
  opt --info <style> fzf_info "Finder info style"
  opt --prompt <prompt> = "> " | "❯ " "Input prompt"
  opt --pointer <str> = ">" | "▶" "Current-line pointer" hidden
  opt --marker <str> = ">" | "✓" "Multi-select marker" hidden
  opt --header <header> "Header text"
  opt --header-lines <n> = 1 | 2 "Treat the first N input lines as a header"
  opt --header-first "Print the header before the prompt" hidden
  opt --footer <footer> "Footer text (0.58+)" hidden
  opt --ghost <text> "Placeholder text when the query is empty" hidden
  opt --color <colspec> = dark | light | 16 | bw | "fg:#d0d0d0,bg:-1,hl:#5f87af" "Color scheme and/or custom colors"
  opt --no-color "Disable colors" hidden
  opt --preview <command> fzf_preview "Command to preview the current line ({} {1} {q} {+})"
  opt --preview-window <opts> fzf_preview_window "Preview window layout"
  opt --preview-label <label> "Label on the preview border" hidden
  opt -q --query <query> "Start with this query"
  opt -1 --select-1 "Auto-select if there's only one match"
  opt -0 --exit-0 "Exit immediately if there's no match"
  opt -f --filter <query> "Non-interactive: print matches for a query and exit"
  opt --print-query "Print the query as the first line"
  opt --expect <keys> list(",") = ctrl-v | ctrl-x | ctrl-t | alt-enter "Keys that also accept; the key is printed first"
  opt --bind <bindings...> fzf_bind "Key/event bindings (key:action[+action])"
  opt --with-shell <shell> = "bash -c" | "zsh -c" "Shell to run child commands with" hidden
  opt --listen [address] = 6266 | "localhost:6266" "Listen for actions over HTTP" hidden
  opt --walker <opts> list(",") = file | dir | follow | hidden "What the built-in walker lists (when there's no input)"
  opt --walker-root <dir...> dir "Directories for the built-in walker"
  opt --walker-skip <dirs> list(",") = .git | node_modules | target | out "Directory names the walker skips"
  opt --history <file> file "Store query history in a file" hidden
  opt --history-size <n> = 1000 | 10000 "Max query history entries" hidden
  opt --tabstop <spaces> = 4 | 8 "Tab width" hidden
  opt --gap [n] = 1 "Empty lines between items" hidden
  opt --gap-line [str] = "─" "Draw a line in each gap" hidden
  opt --raw "Raw mode: show non-matching items dimmed" hidden
  opt --no-bold "Don't use bold text" hidden
  opt --border-label-pos <col> = 0 | 2 | "-2" | "0:bottom" "Position of the border label" hidden
  opt --list-border [style] fzf_border "Border around the list section" hidden
  opt --list-label <label> "Label on the list border" hidden
  opt --input-border [style] fzf_border "Border around the input section" hidden
  opt --input-label <label> "Label on the input border" hidden
  opt --header-border [style] fzf_border "Border around the header" hidden
  opt --header-lines-border [style] fzf_border "Separate border for --header-lines" hidden
  opt --header-label <label> "Label on the header border" hidden
  opt --footer-border [style] fzf_border "Border around the footer" hidden
  opt --no-input "Hide the input section" hidden
  opt --separator <str> = "─" | "" "Info line separator" hidden
  opt --no-separator "Hide the info line separator" hidden
  opt --no-scrollbar "Hide the scrollbar" hidden
  opt --scroll-off <lines> = 3 | 5 "Lines kept visible above/below the cursor" hidden
  opt --hscroll-off <cols> = 10 "Columns kept visible right of the match" hidden
  opt --jump-labels <chars> "Label characters for jump mode" hidden
  opt --ellipsis <str> = ".." | "…" "Truncation indicator" hidden
  opt --info-command <command> "Command generating the info line" hidden
  opt --filepath-word "Word movements respect path separators" hidden
  opt --nushell "Print the Nushell integration script" hidden
  opt --zsh "Print the zsh integration script"
  opt --bash "Print the bash integration script" hidden
  opt --fish "Print the fish integration script" hidden
  opt --man "Show the man page" hidden
  opt --version "Print the version"
  opt -h --help "Print help"

  recipe "Pick a file with a bat preview and open it in nvim"
    $ fzf --preview 'bat --color=always --style=numbers --line-range=:500 {}' --bind 'enter:become(nvim {})'

  recipe "Live ripgrep: search as you type, open the match in nvim"
    $ fzf --ansi --disabled --delimiter : --bind 'start,change:reload:rg --column --color=always --smart-case {q} || :' --preview 'bat --color=always --highlight-line {2} {1}' --preview-window 'up:60%:+{2}-/2' --bind 'enter:become(nvim {1} +{2})'

  recipe "Inline picker below the prompt with multi-select"
    $ fzf --height 40% --layout reverse --border --multi

  recipe "Open fzf in a tmux popup"
    $ fzf --tmux center,80%

recipe "Pick a git branch and check it out"
  $ git branch --format='%(refname:short)' | fzf --preview 'git log --oneline --color=always -n 30 {}' | xargs -r git checkout

recipe "Pick a commit and show it"
  $ git log --oneline --color=always | fzf --ansi --no-sort --preview 'git show --color=always {1}' | cut -d' ' -f1 | xargs -r git show

recipe "Kill processes picked interactively"
  $ ps -ef | fzf --header-lines=1 --multi | awk '{ print $2 }' | xargs -r kill

recipe "Pick a file from git ls-files and open it in nvim"
  $ git ls-files | fzf --multi --preview 'bat --color=always {}' | xargs -r nvim

recipe "Pick a directory and cd into it"
  $ cd "$(fd -t d --hidden --exclude .git | fzf --preview 'ls -la {}')"
